# Disalin menjadi .env.produksi di VPS lalu diisi. Berkas aslinya tidak disimpan di laptop.
FOLDER_DATA=/opt/skripsi-danur/data
FOLDER_STORAGE=/opt/skripsi-danur/storage
DB_PASSWORD=isi-dengan-openssl-rand-hex-24
DB_ROOT_PASSWORD=isi-dengan-openssl-rand-hex-24
KUNCI_LAYANAN=isi-dengan-openssl-rand-hex-32

# API key Gemini milik peneliti (aistudio.google.com). Kosongkan untuk menonaktifkan validasi objek.
GEMINI_API_KEY=
# Opsional: nama model Gemini. Bawaan gemini-flash-lite-latest.
# GEMINI_MODEL=gemini-flash-lite-latest
