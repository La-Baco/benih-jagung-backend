# Disalin menjadi .env.laravel di VPS. APP_KEY dibuat dengan: echo "base64:$(openssl rand -base64 32)"
APP_NAME="Klasifikasi Benih Jagung Ketan Putih"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://skripsi-danur.synvorateknologiindonesia.web.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=single
LOG_LEVEL=warning
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
DB_CONNECTION=mysql
